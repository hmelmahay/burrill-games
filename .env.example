# Copy to .env.local for local dev. None of these are committed.

# Public browser-side values — they ship in every visitor's bundle, so they are
# not secrets. Grab them from the Supabase project's API settings. Any
# placeholder works for a build-only check (`npm run build`).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-ONLY secret — used by /api/bots/answer so bots can reason about the
# question. Never expose it with a NEXT_PUBLIC_ prefix. Optional: without it
# the route returns 503 and bots guess blind (the games still work).
ANTHROPIC_API_KEY=sk-ant-...
